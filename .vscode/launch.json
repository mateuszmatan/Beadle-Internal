{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Beadle-Internal (local)",
      "request": "launch",
      "mainClass": "com.bbh.itss.beadle.internal.BeadleInternalApplication",
      "projectName": "beadle-internal",
      "env": {
        "BEADLE_SERVICE_TOKEN": "${input:serviceToken}"
      }
    }
  ],
  "inputs": [
    {
      "id": "serviceToken",
      "type": "promptString",
      "description": "BEADLE_SERVICE_TOKEN, the same value Beadle-GUI sends",
      "password": true
    }
  ]
}
